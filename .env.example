APP_NAME="JW Pencraft Solutions"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database
# Development commonly uses SQLite. Production should use MySQL/MariaDB
# (or another managed SQL database). Do not commit real credentials.
# ---------------------------------------------------------------------------
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=jw_pencraft
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (HTTPS): SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Queue tables exist, but this app currently has no application jobs.
# Prefer sync in production unless a real queued workload is added.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Contact enquiries are stored in the database; they are NOT emailed.
# Configure real SMTP only when outbound mail is intentionally enabled.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Behind a reverse proxy / TLS terminator, enable trustProxies in bootstrap/app.php
# for that host (see docs/deployment.md). Do not rely on env() after config:cache.
# TRUSTED_PROXIES is reserved for documentation/ops notes:
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Production checklist (set in the real server .env — never commit .env)
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://[TO BE CONFIRMED]
# APP_KEY=base64:...   # generate once with `php artisan key:generate` and preserve
# LOG_LEVEL=error
# LOG_STACK=daily
# SESSION_SECURE_COOKIE=true
# DB_CONNECTION=mysql
# ---------------------------------------------------------------------------
